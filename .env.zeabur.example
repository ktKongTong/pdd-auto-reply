# ==============================================================================
# 拼多多自动回复系统 - Zeabur 环境变量配置说明与参考文件
# 拼多多自动回复系统 - Zeabur 环境变量配置参考（采用 Zeabur 变量引用语法）
# ------------------------------------------------------------------------------
# 用途：指导在 Zeabur 控制台配置多服务环境变量（可直接点击 "Edit as Raw" 复制粘贴）。
# 架构：
#   - 内网通信统一采用 Zeabur 内部私有域名：*.zeabur.internal
#   - 基础服务（MySQL / Redis）推荐从 Zeabur Marketplace 一键创建
#   - 仅 frontend 服务需分配公网域名，其余 5 个服务均为内网私有服务
# 说明：
#   本项目各服务支持全面采用 Zeabur 的 `${VARIABLE_NAME}` 变量引用语法。
#   在 Zeabur 中：
#     1. MySQL / Redis 预置服务会自动暴露相关变量（如 MYSQL_HOST、MYSQL_PASSWORD 等）。
#     2. 每个服务会自动暴露自身内网主机名变量（如 ${BACKEND_HOST}、${WEBSOCKET_HOST} 等）。
#     3. backend 生成的安全密钥（JWT_SECRET_KEY 等）勾选 Expose 后，
#        websocket 和 scheduler 可直接通过 ${KEY} 引用，无需重复粘贴。
#
#   使用方法：在 Zeabur 控制台各服务的 "Variables" 页面，点击 "Edit as Raw"，
#   直接粘贴对应服务的块内容即可。
# ==============================================================================

# ==============================================================================
# 1. backend 服务（HTTP API）环境变量
# 1. backend 服务（HTTP API 核心）
# ==============================================================================
# [必需] 构建文件路径（告知 Zeabur 根上下文下的 Dockerfile 相对路径）
# 构建配置
ZBPACK_DOCKERFILE_PATH=backend/Dockerfile

# 运行环境
# 基础运行环境
ENVIRONMENT=production
TZ=Asia/Shanghai
LOG_LEVEL=INFO

# 数据库连接（Zeabur Marketplace MySQL 自动提供，可直接引用或填入内网地址）
MYSQL_HOST=mysql.zeabur.internal
MYSQL_PORT=3306
MYSQL_USER=root
# 如使用 Zeabur 环境变量引用语法，可填入：${MYSQL.PASSWORD}
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=pdd_auto_reply
# 数据库连接：使用 Zeabur 变量引用语法自动绑定 MySQL 服务的参数
MYSQL_HOST=${MYSQL_HOST}
MYSQL_PORT=${MYSQL_PORT}
MYSQL_USER=${MYSQL_USERNAME}
MYSQL_PASSWORD=${MYSQL_PASSWORD}
MYSQL_DATABASE=${MYSQL_DATABASE}

# Redis 缓存（Zeabur Marketplace Redis 自动提供）
REDIS_HOST=redis.zeabur.internal
REDIS_PORT=6379
# 如使用 Zeabur 环境变量引用语法，可填入：${REDIS.PASSWORD}
REDIS_PASSWORD=your_redis_password
# Redis 缓存：使用 Zeabur 变量引用语法自动绑定 Redis 服务的参数
REDIS_HOST=${REDIS_HOST}
REDIS_PORT=${REDIS_PORT}
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_DB=0

# 服务间内部调用地址（通过 Zeabur 内网通信，禁止写死 localhost）
# 服务端口与内部调用地址
BACKEND_WEB_PORT=8089
BACKEND_WEB_SERVICE_URL=http://backend.zeabur.internal:8089
WEBSOCKET_SERVICE_URL=http://websocket.zeabur.internal:8090
SCHEDULER_SERVICE_URL=http://scheduler.zeabur.internal:8091
BACKEND_WEB_SERVICE_URL=http://${BACKEND_HOST}:${BACKEND_WEB_PORT}
WEBSOCKET_SERVICE_URL=http://${WEBSOCKET_HOST}:8090
SCHEDULER_SERVICE_URL=http://${SCHEDULER_HOST}:8091

# 安全密钥（生产务必生成强随机串，例如执行 openssl rand -hex 32）
# 安全密钥（在 backend 中设定后请勾选 Expose，供 websocket 与 scheduler 引用）
JWT_SECRET_KEY=generate-a-strong-jwt-secret-key-32-chars
DATA_ENCRYPT_KEY=generate-a-strong-data-encrypt-key-32
INTERNAL_SERVICE_TOKEN=generate-a-strong-internal-service-token

# 初始管理员账号（仅在数据库无用户时首次启动自检自动生成，登录后请立即修改）
# 初始超级管理员（首次启动自检时创建，登录后请立即在后台修改）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=your_strong_admin_password_2026

# [存储挂载]
# 请在 backend 服务的 Settings -> Storage 中添加持久化卷：
# [存储配置]
# 请在 backend 的 Settings -> Storage 中挂载 Persistent Volume：
# 挂载目录: /app/backend/static


# ==============================================================================
# 2. websocket 服务（拼多多长连接与浏览器会话）环境变量
# 2. websocket 服务（拼多多长连接与浏览器会话）
# ==============================================================================
# [必需] 构建文件路径
# 构建配置
ZBPACK_DOCKERFILE_PATH=websocket/Dockerfile

ENVIRONMENT=production
TZ=Asia/Shanghai
LOG_LEVEL=INFO

# 数据库与 Redis（与 backend 保持一致）
MYSQL_HOST=mysql.zeabur.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=pdd_auto_reply
REDIS_HOST=redis.zeabur.internal
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
# 数据库与 Redis：全部引用已暴露的环境变量
MYSQL_HOST=${MYSQL_HOST}
MYSQL_PORT=${MYSQL_PORT}
MYSQL_USER=${MYSQL_USERNAME}
MYSQL_PASSWORD=${MYSQL_PASSWORD}
MYSQL_DATABASE=${MYSQL_DATABASE}

REDIS_HOST=${REDIS_HOST}
REDIS_PORT=${REDIS_PORT}
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_DB=0

# 服务间通信
WEBSOCKET_PORT=8090
BACKEND_WEB_SERVICE_URL=http://backend.zeabur.internal:8089
WEBSOCKET_SERVICE_URL=http://websocket.zeabur.internal:8090
SCHEDULER_SERVICE_URL=http://scheduler.zeabur.internal:8091
BACKEND_WEB_SERVICE_URL=http://${BACKEND_HOST}:8089
WEBSOCKET_SERVICE_URL=http://${WEBSOCKET_HOST}:${WEBSOCKET_PORT}
SCHEDULER_SERVICE_URL=http://${SCHEDULER_HOST}:8091

# 安全密钥（与 backend 一致）
JWT_SECRET_KEY=generate-a-strong-jwt-secret-key-32-chars
DATA_ENCRYPT_KEY=generate-a-strong-data-encrypt-key-32
INTERNAL_SERVICE_TOKEN=generate-a-strong-internal-service-token
# 安全密钥：直接引用 backend 服务暴露出来的密钥，无需手动重复维护
JWT_SECRET_KEY=${JWT_SECRET_KEY}
DATA_ENCRYPT_KEY=${DATA_ENCRYPT_KEY}
INTERNAL_SERVICE_TOKEN=${INTERNAL_SERVICE_TOKEN}

# [重要] Playwright 云端无头模式（云容器无 X11 显示环境，必须为 true）
# Playwright 云端无头模式（云容器环境无显示器，必须为 true）
BROWSER_HEADLESS=true
MAX_CAPTCHA_CONCURRENT=1
PLAYWRIGHT_USER_DATA_DIR=/app/websocket/browser_data

# [代理设置] 若海外服务器被拼多多风控拦截，可开启代理：
# [代理可选配置] 如 overseas 机房 IP 遭遇拼多多风控，可在此开启：
# PROXY_ENABLED=true
# PROXY_API_URL=http://username:password@proxy-host:port
# PROXY_API_URL=http://user:pass@proxy-host:port

# [存储挂载]
# 请在 websocket 服务的 Settings -> Storage 中添加持久化卷：
# [存储配置]
# 请在 websocket 的 Settings -> Storage 中挂载 Persistent Volume：
# 挂载目录: /app/websocket/browser_data


# ==============================================================================
# 3. scheduler 服务（定时调度）环境变量
# 3. scheduler 服务（定时调度器）
# ==============================================================================
# [必需] 构建文件路径
# 构建配置
ZBPACK_DOCKERFILE_PATH=scheduler/Dockerfile

ENVIRONMENT=production
TZ=Asia/Shanghai
LOG_LEVEL=INFO

MYSQL_HOST=mysql.zeabur.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=pdd_auto_reply
REDIS_HOST=redis.zeabur.internal
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
# 数据库与 Redis：全部引用已暴露的环境变量
MYSQL_HOST=${MYSQL_HOST}
MYSQL_PORT=${MYSQL_PORT}
MYSQL_USER=${MYSQL_USERNAME}
MYSQL_PASSWORD=${MYSQL_PASSWORD}
MYSQL_DATABASE=${MYSQL_DATABASE}

REDIS_HOST=${REDIS_HOST}
REDIS_PORT=${REDIS_PORT}
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_DB=0

# 服务间通信
SCHEDULER_PORT=8091
BACKEND_WEB_SERVICE_URL=http://backend.zeabur.internal:8089
WEBSOCKET_SERVICE_URL=http://websocket.zeabur.internal:8090
SCHEDULER_SERVICE_URL=http://scheduler.zeabur.internal:8091
BACKEND_WEB_SERVICE_URL=http://${BACKEND_HOST}:8089
WEBSOCKET_SERVICE_URL=http://${WEBSOCKET_HOST}:8090
SCHEDULER_SERVICE_URL=http://${SCHEDULER_HOST}:${SCHEDULER_PORT}

JWT_SECRET_KEY=generate-a-strong-jwt-secret-key-32-chars
DATA_ENCRYPT_KEY=generate-a-strong-data-encrypt-key-32
# 安全密钥：引用 backend 暴露的密钥
JWT_SECRET_KEY=${JWT_SECRET_KEY}
DATA_ENCRYPT_KEY=${DATA_ENCRYPT_KEY}


# ==============================================================================
# 4. frontend 服务（Vue 3 + Nginx 反向代理）环境变量
# 4. frontend 服务（Vue 3 + Nginx 反代网关）
# ==============================================================================
# [必需] 构建文件路径
# 构建配置
ZBPACK_DOCKERFILE_PATH=frontend/Dockerfile

TZ=Asia/Shanghai

# Nginx 反向代理目标后端地址（由 Nginx 官方镜像内置 envsubst 自动替换模板）
BACKEND_API_URL=http://backend.zeabur.internal:8089
# Nginx 反代后端目标地址：直接引用 backend 主机
BACKEND_API_URL=http://${BACKEND_HOST}:8089

# [域名配置]
# [公网域名]
# 请在 frontend 服务的 Networking 面板中：
# 点击 "Generate Domain" 或绑定自定义域名，对外暴露 HTTP(S) 访问。

# 点击 "Generate Domain" 生成免费二级域名，或绑定自定义域名。
